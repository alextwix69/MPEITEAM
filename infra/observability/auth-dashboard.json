{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Managed Prometheus с метриками Команда.МЭИ",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "komanda-auth",
  "title": "Команда.МЭИ — вход и восстановление доступа",
  "tags": ["komanda", "identity"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Auth-команды по результату",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, operation, result) (rate(identity_auth_commands_total[5m]))",
          "legendFormat": "{{service}} {{operation}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Доля отказов auth-команд",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, operation) (rate(identity_auth_commands_total{result=\"failed\"}[10m])) / sum by (service, operation) (rate(identity_auth_commands_total[10m]))",
          "legendFormat": "{{service}} {{operation}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Отказы Origin/CSRF за 5 минут",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (increase(identity_csrf_failures_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Reset: попытки доставки",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, result) (rate(outbox_delivery_attempts_total{consumer=\"identity.password-reset-email\"}[5m]))",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Reset: возраст старейшей незавершённой доставки",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (outbox_delivery_oldest_pending_age{consumer=\"identity.password-reset-email\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Reset: backlog и DLQ",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service, state) (outbox_delivery_backlog{consumer=\"identity.password-reset-email\"})",
          "legendFormat": "{{service}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Reset: длительность успешной обработки p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(outbox_delivery_duration_bucket{consumer=\"identity.password-reset-email\"}[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Доступность сбора метрик",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"komanda-api|komanda-worker\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    }
  ]
}
