{
  "title": "Komanda Files",
  "schemaVersion": 41,
  "panels": [
    {
      "type": "timeseries",
      "title": "Processing p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(files_processing_duration_milliseconds_bucket[10m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue oldest age",
      "targets": [{ "expr": "max by (queue) (files_queue_oldest_age_seconds)" }]
    },
    {
      "type": "timeseries",
      "title": "Queue backlog",
      "targets": [{ "expr": "max by (queue) (files_queue_backlog)" }]
    },
    {
      "type": "timeseries",
      "title": "Processing results",
      "targets": [{ "expr": "sum by (result, scope) (rate(files_processing_results_total[5m]))" }]
    }
  ]
}
