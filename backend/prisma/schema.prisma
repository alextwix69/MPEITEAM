generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "platform", "profiles", "files", "catalog", "trust", "notifications"]
}

enum IdentityFormalRole {
  student
  teacher
  employer

  @@map("formal_role")
  @@schema("identity")
}

enum SystemRole {
  user
  moderator

  @@map("system_role")
  @@schema("identity")
}

enum AccountState {
  unverified
  active
  deleting
  deleted

  @@map("account_state")
  @@schema("identity")
}

enum AuthTokenPurpose {
  email_verification
  password_reset

  @@map("auth_token_purpose")
  @@schema("identity")
}

enum ConsentDocumentType {
  age_18
  user_terms
  personal_data
  public_profile_distribution

  @@map("consent_document_type")
  @@schema("identity")
}

enum PublicationState {
  draft
  pending
  published
  revision_required
  hidden
  deleting

  @@map("publication_state")
  @@schema("profiles")
}

enum PublicVersionState {
  draft
  pending
  approved
  rejected

  @@map("public_version_state")
  @@schema("profiles")
}

enum IdempotencyState {
  in_progress
  completed
  failed

  @@map("idempotency_state")
  @@schema("platform")
}

enum OutboxDeliveryState {
  pending
  leased
  completed
  dead_letter

  @@map("outbox_delivery_state")
  @@schema("platform")
}

enum ContentScope {
  private_message
  public_content

  @@map("content_scope")
  @@schema("files")
}

enum UploadSessionState {
  created
  uploaded
  processing
  technically_ready
  failed
  expired
  consumed

  @@map("upload_session_state")
  @@schema("files")
}

enum MediaObjectState {
  uploaded
  quarantined
  sanitized
  technically_ready
  moderation_pending
  approved
  rejected
  moderation_failed
  attached
  deleting
  deleted

  @@map("media_object_state")
  @@schema("files")
}

enum MediaRetentionClass {
  message_photo
  profile_asset
  resume_asset
  team_asset
  opportunity_asset
  event_asset

  @@map("media_retention_class")
  @@schema("files")
}

enum MediaBindingOwnerType {
  profile_version
  resume_version
  team_version
  opportunity_version
  event_version
  message

  @@map("media_binding_owner_type")
  @@schema("files")
}

enum MediaTombstoneState {
  pending
  in_progress
  completed
  failed

  @@map("media_tombstone_state")
  @@schema("files")
}

enum CatalogVersionState {
  draft
  active
  retired

  @@map("catalog_version_state")
  @@schema("catalog")
}

enum ModerationContentType {
  profile_version
  resume_version
  team_version
  opportunity_version
  event_version
  public_media

  @@map("moderation_content_type")
  @@schema("trust")
}

enum ModerationRequestState {
  pending
  in_progress
  approved
  rejected
  failed

  @@map("moderation_request_state")
  @@schema("trust")
}

enum ModerationEndpoint {
  primary
  secondary

  @@map("moderation_endpoint")
  @@schema("trust")
}

enum ModerationOutcome {
  approved
  return_for_revision

  @@map("moderation_outcome")
  @@schema("trust")
}

enum EmailDeliveryState {
  pending
  sending
  sent
  failed
  dead_letter

  @@map("email_delivery_state")
  @@schema("notifications")
}

model Account {
  id                     String             @id @db.Uuid
  emailNormalized        String             @unique(map: "accounts_email_normalized_key") @map("email_normalized") @db.VarChar(320)
  formalRole             IdentityFormalRole @map("formal_role")
  systemRole             SystemRole         @default(user) @map("system_role")
  state                  AccountState       @default(unverified)
  emailVerifiedAt        DateTime?          @map("email_verified_at") @db.Timestamptz(6)
  deletionRequestedAt    DateTime?          @map("deletion_requested_at") @db.Timestamptz(6)
  deletionIrreversibleAt DateTime?          @map("deletion_irreversible_at") @db.Timestamptz(6)
  lastLoginAt            DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion             BigInt             @default(0) @map("row_version")
  credential             Credential?
  authTokens             AuthToken[]
  sessions               Session[]
  consents               ConsentStatus[]

  @@index([lastLoginAt, id], map: "accounts_active_last_login_idx")
  @@map("accounts")
  @@schema("identity")
}

model Credential {
  accountId         String   @id @map("account_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  argon2Parameters  Json     @map("argon2_parameters")
  passwordChangedAt DateTime @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credentials")
  @@schema("identity")
}

model AuthToken {
  id         String           @id @db.Uuid
  accountId  String           @map("account_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  Bytes            @unique(map: "auth_tokens_token_hash_key") @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt(sort: Desc)], map: "auth_tokens_account_purpose_created_idx")
  @@index([expiresAt, id], map: "auth_tokens_open_expiry_idx")
  @@map("auth_tokens")
  @@schema("identity")
}

model Session {
  id             String    @id @db.Uuid
  sessionHash    Bytes     @unique(map: "sessions_session_hash_key") @map("session_hash")
  accountId      String    @map("account_id") @db.Uuid
  csrfSecretHash Bytes     @map("csrf_secret_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)], map: "sessions_account_active_idx")
  @@index([expiresAt, id], map: "sessions_active_expiry_idx")
  @@map("sessions")
  @@schema("identity")
}

model ConsentStatus {
  accountId       String              @map("account_id") @db.Uuid
  documentType    ConsentDocumentType @map("document_type")
  documentVersion String              @map("document_version") @db.VarChar(64)
  acceptedAt      DateTime?           @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?           @map("revoked_at") @db.Timestamptz(6)
  sourceEventId   String              @map("source_event_id") @db.Uuid
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, documentType])
  @@map("consent_statuses")
  @@schema("identity")
}

model Profile {
  id                 String             @id @db.Uuid
  accountId          String             @unique(map: "profiles_account_id_key") @map("account_id") @db.Uuid
  formalRole         IdentityFormalRole @map("formal_role")
  timezone           String             @default("Europe/Moscow") @db.VarChar(64)
  publicationState   PublicationState   @default(draft) @map("publication_state")
  publishedVersionId String?            @map("published_version_id") @db.Uuid
  pendingVersionId   String?            @map("pending_version_id") @db.Uuid
  editLocked         Boolean            @default(false) @map("edit_locked")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         BigInt             @default(1) @map("row_version")
  versions           ProfileVersion[]
  resumes            Resume[]

  @@map("profiles")
  @@schema("profiles")
}

model ProfileVersion {
  id                       String             @id @db.Uuid
  profileId                String             @map("profile_id") @db.Uuid
  versionNo                Int                @map("version_no")
  state                    PublicVersionState @default(draft)
  fullName                 String             @map("full_name") @db.VarChar(200)
  specialization           String             @db.VarChar(200)
  institute                String?            @db.VarChar(200)
  course                   Int?               @db.SmallInt
  department               String?            @db.VarChar(200)
  company                  String?            @db.VarChar(200)
  position                 String?            @db.VarChar(200)
  avatarMediaId            String?            @map("avatar_media_id") @db.Uuid
  submittedAt              DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedAt                DateTime?          @map("decided_at") @db.Timestamptz(6)
  moderationDecisionId     String?            @map("moderation_decision_id") @db.Uuid
  moderationPolicyVersion  String?            @map("moderation_policy_version") @db.VarChar(64)
  moderationViolationCodes String[]           @default([]) @map("moderation_violation_codes")
  moderationReason         String?            @map("moderation_reason") @db.VarChar(2000)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  profile                  Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNo], map: "profile_versions_profile_version_key")
  @@map("profile_versions")
  @@schema("profiles")
}

model Resume {
  id                 String           @id @db.Uuid
  profileId          String           @map("profile_id") @db.Uuid
  slot               Int              @db.SmallInt
  isSearchVisible    Boolean          @map("is_search_visible")
  publicationState   PublicationState @default(draft) @map("publication_state")
  publishedVersionId String?          @map("published_version_id") @db.Uuid
  pendingVersionId   String?          @map("pending_version_id") @db.Uuid
  editLocked         Boolean          @default(false) @map("edit_locked")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         BigInt           @default(1) @map("row_version")
  profile            Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  versions           ResumeVersion[]

  @@unique([profileId, slot], map: "resumes_profile_slot_key")
  @@map("resumes")
  @@schema("profiles")
}

model ResumeVersion {
  id                       String             @id @db.Uuid
  resumeId                 String             @map("resume_id") @db.Uuid
  versionNo                Int                @map("version_no")
  state                    PublicVersionState @default(draft)
  about                    String             @db.VarChar(1024)
  imageMediaId             String?            @map("image_media_id") @db.Uuid
  submittedAt              DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedAt                DateTime?          @map("decided_at") @db.Timestamptz(6)
  moderationDecisionId     String?            @map("moderation_decision_id") @db.Uuid
  moderationPolicyVersion  String?            @map("moderation_policy_version") @db.VarChar(64)
  moderationViolationCodes String[]           @default([]) @map("moderation_violation_codes")
  moderationReason         String?            @map("moderation_reason") @db.VarChar(2000)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  resume                   Resume             @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  projects                 ResumeProject[]
  tags                     ResumeVersionTag[]

  @@unique([resumeId, versionNo], map: "resume_versions_resume_version_key")
  @@map("resume_versions")
  @@schema("profiles")
}

model ResumeProject {
  resumeVersionId String        @map("resume_version_id") @db.Uuid
  position        Int           @db.SmallInt
  title           String        @db.VarChar(200)
  description     String        @db.VarChar(2000)
  url             String?       @db.VarChar(2048)
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@id([resumeVersionId, position])
  @@map("resume_projects")
  @@schema("profiles")
}

model ResumeVersionTag {
  resumeVersionId String        @map("resume_version_id") @db.Uuid
  tagId           String        @map("tag_id") @db.Uuid
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@id([resumeVersionId, tagId])
  @@map("resume_version_tags")
  @@schema("profiles")
}

model ProfilesInboxEvent {
  eventId      String   @id @map("event_id") @db.Uuid
  consumer     String   @db.VarChar(100)
  eventVersion Int      @map("event_version") @db.SmallInt
  processedAt  DateTime @map("processed_at") @db.Timestamptz(6)
  resultRefId  String?  @map("result_ref_id") @db.Uuid

  @@index([processedAt, eventId], map: "profiles_inbox_processed_idx")
  @@map("inbox_events")
  @@schema("profiles")
}

model CatalogVersion {
  id          String              @id @db.Uuid
  version     String              @unique @db.VarChar(32)
  state       CatalogVersionState
  publishedAt DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tags        CatalogTag[]

  @@map("versions")
  @@schema("catalog")
}

model CatalogTag {
  id               String         @id @db.Uuid
  catalogVersionId String         @map("catalog_version_id") @db.Uuid
  code             String         @db.VarChar(80)
  name             String         @db.VarChar(120)
  category         String         @db.VarChar(120)
  sortOrder        Int            @map("sort_order") @db.SmallInt
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersion   CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)

  @@unique([catalogVersionId, code], map: "tags_version_code_key")
  @@unique([catalogVersionId, sortOrder], map: "tags_version_sort_order_key")
  @@map("tags")
  @@schema("catalog")
}

model ModerationRequest {
  id                 String                 @id @db.Uuid
  contentType        ModerationContentType  @map("content_type")
  contentVersionId   String                 @map("content_version_id") @db.Uuid
  ownerAccountId     String                 @map("owner_account_id") @db.Uuid
  policyVersion      String                 @map("policy_version") @db.VarChar(64)
  state              ModerationRequestState @default(pending)
  generation         Int                    @default(1)
  activeEndpoint     ModerationEndpoint     @default(primary) @map("active_endpoint")
  providerRequestKey String                 @unique @map("provider_request_key") @db.VarChar(200)
  pendingSince       DateTime               @map("pending_since") @db.Timestamptz(6)
  leaseUntil         DateTime?              @map("lease_until") @db.Timestamptz(6)
  decidedAt          DateTime?              @map("decided_at") @db.Timestamptz(6)
  violationCodes     String[]               @default([]) @map("violation_codes")
  failureCode        String?                @map("failure_code") @db.VarChar(100)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         BigInt                 @default(0) @map("row_version")

  @@unique([contentType, contentVersionId, policyVersion], map: "moderation_request_content_key")
  @@index([state, pendingSince, id], map: "moderation_requests_pending_idx")
  @@map("moderation_requests")
  @@schema("trust")
}

model ModerationDecision {
  id               String            @id @db.Uuid
  sourceId         String            @unique @map("source_id") @db.Uuid
  contentType      String            @map("content_type") @db.VarChar(32)
  contentId        String            @map("content_id") @db.Uuid
  contentVersionId String            @map("content_version_id") @db.Uuid
  outcome          ModerationOutcome
  policyVersion    String            @map("policy_version") @db.VarChar(64)
  violationCodes   String[]          @default([]) @map("violation_codes")
  reason           String?           @db.VarChar(2000)
  decidedAt        DateTime          @map("decided_at") @db.Timestamptz(6)

  @@index([contentType, contentId, decidedAt(sort: Desc), id], map: "moderation_decisions_content_idx")
  @@map("moderation_decisions")
  @@schema("trust")
}

model TrustInboxEvent {
  eventId      String   @id @map("event_id") @db.Uuid
  consumer     String   @db.VarChar(100)
  eventVersion Int      @map("event_version") @db.SmallInt
  processedAt  DateTime @map("processed_at") @db.Timestamptz(6)
  resultRefId  String?  @map("result_ref_id") @db.Uuid

  @@index([processedAt, eventId], map: "trust_inbox_processed_idx")
  @@map("inbox_events")
  @@schema("trust")
}

model Notification {
  id                 String    @id @db.Uuid
  recipientAccountId String    @map("recipient_account_id") @db.Uuid
  sourceEventId      String    @map("source_event_id") @db.Uuid
  type               String    @db.VarChar(80)
  resourceType       String?   @map("resource_type") @db.VarChar(64)
  resourceId         String?   @map("resource_id") @db.Uuid
  payload            Json
  readAt             DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rowVersion         BigInt    @default(1) @map("row_version")

  @@unique([sourceEventId, recipientAccountId, type], map: "notifications_event_recipient_type_key")
  @@index([recipientAccountId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_recipient_created_idx")
  @@index([recipientAccountId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_recipient_unread_idx")
  @@map("notifications")
  @@schema("notifications")
}

model EmailDelivery {
  id                 String             @id @db.Uuid
  sourceEventId      String             @map("source_event_id") @db.Uuid
  recipientAccountId String             @map("recipient_account_id") @db.Uuid
  templateCode       String             @map("template_code") @db.VarChar(80)
  providerMessageKey String             @unique @map("provider_message_key") @db.VarChar(200)
  state              EmailDeliveryState @default(pending)
  attemptCount       Int                @default(0) @map("attempt_count")
  availableAt        DateTime           @map("available_at") @db.Timestamptz(6)
  leaseUntil         DateTime?          @map("lease_until") @db.Timestamptz(6)
  sentAt             DateTime?          @map("sent_at") @db.Timestamptz(6)
  lastErrorCode      String?            @map("last_error_code") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         BigInt             @default(0) @map("row_version")

  @@unique([sourceEventId, recipientAccountId, templateCode], map: "email_deliveries_event_recipient_template_key")
  @@index([availableAt, id], map: "email_deliveries_due_idx")
  @@map("email_deliveries")
  @@schema("notifications")
}

model NotificationsInboxEvent {
  eventId      String   @id @map("event_id") @db.Uuid
  consumer     String   @db.VarChar(100)
  eventVersion Int      @map("event_version") @db.SmallInt
  processedAt  DateTime @map("processed_at") @db.Timestamptz(6)
  resultRefId  String?  @map("result_ref_id") @db.Uuid

  @@index([processedAt, eventId], map: "notifications_inbox_processed_idx")
  @@map("inbox_events")
  @@schema("notifications")
}

model IdempotencyRecord {
  id                String           @id @db.Uuid
  actorAccountId    String?          @map("actor_account_id") @db.Uuid
  publicSubjectHash Bytes?           @map("public_subject_hash")
  route             String           @db.VarChar(160)
  key               String           @db.VarChar(128)
  requestHash       Bytes            @map("request_hash")
  state             IdempotencyState
  responseStatus    Int?             @map("response_status")
  responseRefType   String?          @map("response_ref_type") @db.VarChar(80)
  responseRefId     String?          @map("response_ref_id") @db.Uuid
  responseBody      Json?            @map("response_body")
  responseSecret    Bytes?           @map("response_secret")
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt, id], map: "idempotency_records_expiry_idx")
  @@map("idempotency_records")
  @@schema("platform")
}

model OutboxEvent {
  id             String           @id @db.Uuid
  eventType      String           @map("event_type") @db.VarChar(120)
  eventVersion   Int              @map("event_version") @db.SmallInt
  aggregateType  String           @map("aggregate_type") @db.VarChar(80)
  aggregateId    String           @map("aggregate_id") @db.Uuid
  occurredAt     DateTime         @map("occurred_at") @db.Timestamptz(6)
  correlationId  String           @map("correlation_id") @db.Uuid
  causationId    String?          @map("causation_id") @db.Uuid
  actorAccountId String?          @map("actor_account_id") @db.Uuid
  payload        Json
  deliveries     OutboxDelivery[]

  @@map("outbox_events")
  @@schema("platform")
}

model OutboxDelivery {
  id            String              @id @db.Uuid
  eventId       String              @map("event_id") @db.Uuid
  consumer      String              @db.VarChar(100)
  state         OutboxDeliveryState @default(pending)
  attemptCount  Int                 @default(0) @map("attempt_count")
  availableAt   DateTime            @map("available_at") @db.Timestamptz(6)
  leaseUntil    DateTime?           @map("lease_until") @db.Timestamptz(6)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  lastErrorCode String?             @map("last_error_code") @db.VarChar(100)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion    BigInt              @default(0) @map("row_version")
  event         OutboxEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumer], map: "outbox_deliveries_event_consumer_key")
  @@index([availableAt, id], map: "outbox_deliveries_due_idx")
  @@index([state, availableAt, id], map: "outbox_deliveries_dead_letter_idx")
  @@map("outbox_deliveries")
  @@schema("platform")
}

model UploadSession {
  id                     String             @id @db.Uuid
  ownerAccountId         String             @map("owner_account_id") @db.Uuid
  contentScope           ContentScope       @map("content_scope")
  ownerType              String             @map("owner_type") @db.VarChar(64)
  ownerRef               String             @map("owner_ref") @db.Uuid
  expectedMime           String             @map("expected_mime") @db.VarChar(64)
  expectedSizeBytes      Int                @map("expected_size_bytes")
  objectKey              String             @unique(map: "upload_sessions_object_key_key") @map("object_key") @db.VarChar(512)
  sourceEtag             String?            @map("source_etag") @db.VarChar(128)
  state                  UploadSessionState @default(created)
  expiresAt              DateTime           @map("expires_at") @db.Timestamptz(6)
  failureCode            String?            @map("failure_code") @db.VarChar(100)
  processingLeaseUntil   DateTime?          @map("processing_lease_until") @db.Timestamptz(6)
  processingAttemptCount Int                @default(0) @map("processing_attempt_count")
  quarantineDeletedAt    DateTime?          @map("quarantine_deleted_at") @db.Timestamptz(6)
  correlationId          String             @map("correlation_id") @db.Uuid
  eventId                String             @unique(map: "upload_sessions_event_id_key") @map("event_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion             BigInt             @default(0) @map("row_version")

  @@index([ownerAccountId, state, createdAt(sort: Desc), id], map: "upload_sessions_owner_state_idx")
  @@index([state, expiresAt, id], map: "upload_sessions_expiry_idx")
  @@index([processingLeaseUntil, id], map: "upload_sessions_processing_lease_idx")
  @@index([updatedAt, id], map: "upload_sessions_quarantine_cleanup_idx")
  @@map("upload_sessions")
  @@schema("files")
}

model MediaObject {
  id                String              @id @db.Uuid
  uploadSessionId   String              @unique(map: "media_objects_upload_session_key") @map("upload_session_id") @db.Uuid
  uploaderAccountId String              @map("uploader_account_id") @db.Uuid
  contentScope      ContentScope        @map("content_scope")
  state             MediaObjectState
  bucket            String              @db.VarChar(128)
  objectKey         String              @map("object_key") @db.VarChar(512)
  sha256            Bytes
  mime              String              @db.VarChar(64)
  sizeBytes         Int                 @map("size_bytes")
  width             Int
  height            Int
  retentionClass    MediaRetentionClass @map("retention_class")
  attachedAt        DateTime?           @map("attached_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        BigInt              @default(0) @map("row_version")
  binding           MediaBinding?

  @@unique([bucket, objectKey], map: "media_objects_bucket_object_key")
  @@index([uploaderAccountId, attachedAt, id], map: "media_objects_message_quota_idx")
  @@index([uploaderAccountId, state, createdAt, id], map: "media_objects_owner_state_idx")
  @@map("media_objects")
  @@schema("files")
}

model MediaBinding {
  mediaId   String                @id @map("media_id") @db.Uuid
  ownerType MediaBindingOwnerType @map("owner_type")
  ownerId   String                @map("owner_id") @db.Uuid
  slot      Int                   @db.SmallInt
  boundAt   DateTime              @map("bound_at") @db.Timestamptz(6)
  media     MediaObject           @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId, slot], map: "media_bindings_owner_slot_key")
  @@map("media_bindings")
  @@schema("files")
}

model MediaDeletionTombstone {
  mediaId       String              @id @map("media_id") @db.Uuid
  bucket        String              @db.VarChar(128)
  objectKey     String              @map("object_key") @db.VarChar(512)
  state         MediaTombstoneState @default(pending)
  attemptCount  Int                 @default(0) @map("attempt_count")
  availableAt   DateTime            @map("available_at") @db.Timestamptz(6)
  leaseUntil    DateTime?           @map("lease_until") @db.Timestamptz(6)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  lastErrorCode String?             @map("last_error_code") @db.VarChar(100)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion    BigInt              @default(0) @map("row_version")

  @@index([availableAt, mediaId], map: "media_tombstones_due_idx")
  @@index([leaseUntil, mediaId], map: "media_tombstones_lease_idx")
  @@map("media_deletion_tombstones")
  @@schema("files")
}
