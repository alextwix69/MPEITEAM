NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
API_DATABASE_URL=postgresql://komanda_api:komanda-api-local@postgres:5432/komanda?schema=public&connection_limit=5&pool_timeout=5
WORKER_DATABASE_URL=postgresql://komanda_worker:komanda-worker-local@postgres:5432/komanda?schema=public&connection_limit=3&pool_timeout=5
DATABASE_URL=postgresql://komanda_admin:komanda-admin-local@postgres:5432/komanda?schema=public
TEST_DATABASE_URL=postgresql://komanda_admin:komanda-admin-local@127.0.0.1:55432/komanda_test?schema=public&connection_limit=2&pool_timeout=3
LEGAL_DATABASE_URL=postgresql://komanda_legal:komanda-legal-local@postgres:5432/komanda_legal?schema=public&connection_limit=2&pool_timeout=5
TEST_LEGAL_DATABASE_URL=postgresql://komanda_legal:komanda-legal-local@127.0.0.1:55432/komanda_legal_test?schema=public&connection_limit=2&pool_timeout=3
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-central-1
S3_BUCKET=komanda-media
S3_ACCESS_KEY=komanda-local
S3_SECRET_KEY=komanda-local-secret
S3_FORCE_PATH_STYLE=true
DEPENDENCY_TIMEOUT_MS=1500
WORKER_HEARTBEAT_KEY=platform:worker:heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_SECONDS=15
OTEL_SERVICE_NAME=komanda-mpei
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_SESSION_TTL_SECONDS=86400
AUTH_TOKEN_ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
IDEMPOTENCY_HMAC_KEY=development-idempotency-key-change-before-production
LEGAL_SUBJECT_HMAC_KEY=development-legal-subject-key-change-before-production
CONSENT_VERSION_AGE_18=local-v1
CONSENT_VERSION_USER_TERMS=local-v1
CONSENT_VERSION_PERSONAL_DATA=local-v1
CONSENT_VERSION_PUBLIC_PROFILE=local-v1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
RESEND_COOLDOWN_SECONDS=60
TRUST_PROXY_HOPS=1
SESSION_COOKIE_SECURE=true
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=no-reply@komanda.mpei.ru
PUBLIC_APP_URL=http://localhost:8080
OUTBOX_POLL_INTERVAL_MS=1000
